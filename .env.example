# Local Development Settings

# Set to 'true' to show the local role selector in development
# This overrides the admin role check (useful for testing)
VITE_USE_LOCAL_ROLE_SELECTOR=false

# Set to 'true' to completely hide the role selector
# This takes precedence over VITE_USE_LOCAL_ROLE_SELECTOR
VITE_FORCE_HIDE_ROLE_SELECTOR=false
